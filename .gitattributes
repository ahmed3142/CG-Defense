# Normalize all text files to LF in the repo; Git converts to CRLF on Windows checkout
* text=auto eol=lf

# Source code — always LF
*.cpp   text eol=lf
*.h     text eol=lf
*.hpp   text eol=lf
*.c     text eol=lf

# Data / config
*.json  text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf

# Windows Makefile — keep CRLF so mingw32-make handles it correctly
Makefile text eol=crlf

# Binary assets — never touch line endings
*.png   binary
*.bmp   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.mp3   binary
*.wav   binary
*.exe   binary
*.a     binary
*.dll   binary
